# EXÉCUTION
# ============================================================

print("============================================================")
print("V9 — TEST ADVERSARIAL DU DECISION ENGINE")
print("============================================================")
print(f"Scénarios : {len(TESTS)}")
print()

passed = 0
failed = []

for test_id, text, expected_level, expected_debate, expected_human in TESTS:

    try:
        result = m.classify(text)

        level = result.get("level")
        debate = result.get("debate")
        human = result.get("human")

        ok = (
            level == expected_level
            and debate == expected_debate
            and human == expected_human
        )

        status = "PASS" if ok else "FAIL"

        print(
            f"{test_id:4} | "
            f"{level:7} | "
            f"débat={str(debate):5} | "
            f"humain={str(human):5} | "
            f"{status:4} | "
            f"{text}"
        )

        if ok:
            passed += 1
        else:
            failed.append({
                "id": test_id,
                "text": text,
                "expected": {
                    "level": expected_level,
                    "debate": expected_debate,
                    "human": expected_human,
                },
                "actual": {
                    "level": level,
                    "debate": debate,
                    "human": human,
                },
            })

    except Exception as e:
        print(f"{test_id:4} | ERREUR | {e} | {text}")
        failed.append({
            "id": test_id,
            "text": text,
            "error": str(e),
        })


