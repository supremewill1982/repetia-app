rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Utilisateurs
    match /users/{userId} {
      // L'utilisateur lit son propre profil.
      // Un parent peut lire le profil de son enfant déjà lié.
      allow read: if request.auth != null
        && (
          request.auth.uid == userId
          || resource.data.parentId == request.auth.uid
        );

      // L'utilisateur peut modifier son propre profil.
      // Un parent peut uniquement renseigner/modifier les champs
      // nécessaires à la liaison de son enfant.
      allow write: if request.auth != null
        && (
          request.auth.uid == userId
          || (
            resource.data.parentId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['parentId', 'parentPrenom'])
          )
        );

      match /{subcollection}/{docId} {
        allow read, write: if request.auth != null
          && request.auth.uid == userId;
      }
    }

    // Élèves — chacun accède à ses propres données
    match /enfants/{userId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;

      match /{subcollection}/{docId} {
        allow read, write: if request.auth != null
          && request.auth.uid == userId;
      }
    }

    // Parents — chacun accède à ses propres données
    match /parents/{userId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;

      match /{subcollection}/{docId} {
        allow read, write: if request.auth != null
          && request.auth.uid == userId;
      }
    }

    // Rankings — lecture pour tous les utilisateurs authentifiés
    match /rankings/{weekKey}/scores/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId;
    }

    // Sessions élèves
    match /sessions/{sessionId} {

      // L'élève peut lire ses propres sessions.
      // Le parent peut lire les sessions de son enfant lié.
      allow read: if request.auth != null
        && (
          resource.data.enfantId == request.auth.uid
          ||
          (
            resource.data.enfantId != null
            && get(
              /databases/$(database)/documents/users/$(resource.data.enfantId)
            ).data.parentId == request.auth.uid
          )
        );

      // Une session ne peut être créée que pour
      // l'utilisateur actuellement authentifié.
      allow create: if request.auth != null
        && request.resource.data.enfantId == request.auth.uid;

      // Seul l'élève propriétaire peut modifier sa session.
      // L'enregistrement ne peut pas être transféré à un autre UID.
      allow update: if request.auth != null
        && resource.data.enfantId == request.auth.uid
        && request.resource.data.enfantId == request.auth.uid;

      // Seul l'élève propriétaire peut supprimer sa session.
      allow delete: if request.auth != null
        && resource.data.enfantId == request.auth.uid;
    }

    // Codes de liaison parent ↔ élève
    match /codesLiaison/{code} {
      // Un utilisateur authentifié peut lire un code afin de
      // permettre au parent de vérifier le code saisi.
      allow read: if request.auth != null;

      // Seul l'élève propriétaire peut créer son code.
      allow create: if request.auth != null
        && request.resource.data.enfantId == request.auth.uid;

      // Seul l'élève propriétaire peut modifier son code.
      allow update: if request.auth != null
        && resource.data.enfantId == request.auth.uid
        && request.resource.data.enfantId == request.auth.uid;

      // L'élève propriétaire peut supprimer son code.
      // Un parent peut supprimer le code après avoir été associé
      // à l'enfant correspondant.
      allow delete: if request.auth != null
        && (
          resource.data.enfantId == request.auth.uid
          || get(/databases/$(database)/documents/users/$(resource.data.enfantId)).data.parentId == request.auth.uid
        );
    }

    // Badges
    match /badges/{userId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }

    // Statistiques de temps — chaque utilisateur accède uniquement à ses propres données
    match /timeStats/{userId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }

    // AudioRévision — Podcasts publics
    match /podcasts_public/{podcastId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null
        && request.auth.uid == resource.data.userId;
    }

    // Likes
    match /likes/{likeId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.userId;
    }

    // Réservations parent ↔ répétiteur
    match /reservations/{reservationId} {
      allow read: if request.auth != null
        && (
          resource.data.eleveId == request.auth.uid
          || resource.data.tuteurId == request.auth.uid
        );

      allow create: if request.auth != null
        && request.resource.data.eleveId == request.auth.uid;

      allow update: if request.auth != null
        && (
          (
            resource.data.eleveId == request.auth.uid
            && request.resource.data.eleveId == resource.data.eleveId
            && request.resource.data.tuteurId == resource.data.tuteurId
          )
          ||
          (
            resource.data.tuteurId == request.auth.uid
            && request.resource.data.eleveId == resource.data.eleveId
            && request.resource.data.tuteurId == resource.data.tuteurId
          )
        );

      allow delete: if request.auth != null
        && resource.data.eleveId == request.auth.uid;
    }
  }
}
