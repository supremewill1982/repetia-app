import React, { useCallback, useState } from 'react';
import {
  View,
  Text,
  StyleSheet,
  FlatList,
  TouchableOpacity,
  ActivityIndicator,
} from 'react-native';
import { useFocusEffect } from '@react-navigation/native';
import { MaterialCommunityIcons } from '@expo/vector-icons';
import { useTheme } from '../../context/ThemeContext';
import { auth } from '../../services/firebaseConfig';
import { db } from '../../services/firebaseConfig';
import {
  collection,
  getDocs,
  query,
  where,
  orderBy,
} from 'firebase/firestore';

type Reservation = {
  id: string;
  tuteurId: string;
  tuteurNom: string;
  matiere: string;
  dureeMin: number;
  prix: number;
  statut: 'en_attente' | 'confirmee' | 'terminee' | 'annulee';
  date: string;
  heure: string;
  message?: string;
  elevePrénom?: string;
};

const STATUTS = {
  en_attente: { label: 'En attente', icon: 'clock-outline' },
  confirmee: { label: 'Confirmée', icon: 'check-circle-outline' },
  terminee: { label: 'Terminée', icon: 'check-all' },
  annulee: { label: 'Annulée', icon: 'close-circle-outline' },
};

export default function MesReservationsParentScreen({
  navigation,
}: any) {
  const { colors } = useTheme();
  const [reservations, setReservations] = useState<Reservation[]>([]);
  const [loading, setLoading] = useState(true);
  const [filtre, setFiltre] = useState<'toutes' | Reservation['statut']>('toutes');

  const charger = useCallback(async () => {
    try {
      setLoading(true);

      const user = auth.currentUser;
      if (!user) {
        setReservations([]);
        return;
      }

      const q = query(
        collection(db, 'reservations'),
        where('eleveId', '==', user.uid),
        orderBy('dateCreation', 'desc')
      );

      const snap = await getDocs(q);

      const data = snap.docs.map((doc) => ({
        id: doc.id,
        ...(doc.data() as Omit<Reservation, 'id'>),
      }));

      setReservations(data);
    } catch (error) {
      console.error('Erreur réservations parent:', error);

      // Fallback sans orderBy si un index Firestore manque.
      try {
        const user = auth.currentUser;
        if (!user) return;

        const q = query(
          collection(db, 'reservations'),
          where('eleveId', '==', user.uid)
        );

        const snap = await getDocs(q);

        const data = snap.docs.map((doc) => ({
          id: doc.id,
          ...(doc.data() as Omit<Reservation, 'id'>),
        }));

        setReservations(data.reverse());
      } catch (fallbackError) {
        console.error('Erreur fallback:', fallbackError);
        setReservations([]);
      }
    } finally {
      setLoading(false);
    }
  }, []);

  useFocusEffect(
    useCallback(() => {
      charger();
    }, [charger])
  );

  const liste =
    filtre === 'toutes'
      ? reservations
      : reservations.filter((r) => r.statut === filtre);

  const couleurStatut = (statut: Reservation['statut']) => {
    if (statut === 'confirmee') return '#2E7D32';
    if (statut === 'terminee') return colors.primary;
    if (statut === 'annulee') return colors.error;
    return '#F59E0B';
  };

  const renderItem = ({ item }: { item: Reservation }) => {
    const statut = STATUTS[item.statut] || STATUTS.en_attente;
    const couleur = couleurStatut(item.statut);

    return (
      <TouchableOpacity
        activeOpacity={0.85}
        style={[
          styles.card,
          {
            backgroundColor: colors.surface,
            borderColor: colors.border,
          },
        ]}
        onPress={() =>
          navigation.navigate('ParentRepetiteurDetail', {
            tuteurId: item.tuteurId,
          })
        }
      >
        <View style={styles.cardTop}>
          <View style={styles.tuteurBlock}>
            <View
              style={[
                styles.avatar,
                { backgroundColor: colors.primary + '18' },
              ]}
            >
              <MaterialCommunityIcons
                name="account-school-outline"
                size={25}
                color={colors.primary}
              />
            </View>

            <View style={{ flex: 1 }}>
              <Text style={[styles.tuteurNom, { color: colors.text }]}>
                {item.tuteurNom || 'Répétiteur'}
              </Text>

              <Text
                style={[styles.matiere, { color: colors.textSecondary }]}
              >
                {item.matiere}
              </Text>
            </View>
          </View>

          <View
            style={[
              styles.statusBadge,
              { backgroundColor: couleur + '18' },
            ]}
          >
            <MaterialCommunityIcons
              name={statut.icon as any}
              size={14}
              color={couleur}
            />
            <Text style={[styles.statusText, { color: couleur }]}>
              {statut.label}
            </Text>
          </View>
        </View>

        <View style={styles.infoGrid}>
          <View style={styles.infoItem}>
            <MaterialCommunityIcons
              name="calendar-outline"
              size={18}
              color={colors.primary}
            />
            <Text style={[styles.infoText, { color: colors.textSecondary }]}>
              {item.date || 'Date à confirmer'}
            </Text>
          </View>

          <View style={styles.infoItem}>
            <MaterialCommunityIcons
              name="clock-outline"
              size={18}
              color={colors.primary}
            />
            <Text style={[styles.infoText, { color: colors.textSecondary }]}>
              {item.heure || 'Heure à confirmer'}
            </Text>
          </View>

          <View style={styles.infoItem}>
            <MaterialCommunityIcons
              name="timer-outline"
              size={18}
              color={colors.primary}
            />
            <Text style={[styles.infoText, { color: colors.textSecondary }]}>
              {item.dureeMin} min
            </Text>
          </View>

          <View style={styles.infoItem}>
            <MaterialCommunityIcons
              name="cash"
              size={18}
              color={colors.primary}
            />
            <Text style={[styles.price, { color: colors.text }]}>
              {(item.prix || 0).toLocaleString()} FCFA
            </Text>
          </View>
        </View>

        {item.elevePrénom ? (
          <Text style={[styles.child, { color: colors.textMuted }]}>
            👤 Élève : {item.elevePrénom}
          </Text>
        ) : null}

        {item.message ? (
          <View
            style={[
              styles.message,
              { backgroundColor: colors.background },
            ]}
          >
            <Text style={[styles.messageText, { color: colors.textMuted }]}>
              « {item.message} »
            </Text>
          </View>
        ) : null}

        <View style={styles.cardFooter}>
          <Text style={[styles.detailsLink, { color: colors.primary }]}>
            Voir le répétiteur
          </Text>

          <MaterialCommunityIcons
            name="chevron-right"
            size={20}
            color={colors.primary}
          />
        </View>
      </TouchableOpacity>
    );
  };

  if (loading) {
    return (
      <View
        style={[
          styles.center,
          { backgroundColor: colors.background },
        ]}
      >
        <ActivityIndicator size="large" color={colors.primary} />
        <Text style={[styles.loadingText, { color: colors.textMuted }]}>
          Chargement de vos réservations…
        </Text>
      </View>
    );
  }

  return (
    <View
      style={[
        styles.container,
        { backgroundColor: colors.background },
      ]}
    >
      <View
        style={[
          styles.header,
          {
            backgroundColor: colors.surface,
            borderBottomColor: colors.border,
          },
        ]}
      >
        <View>
          <Text style={[styles.title, { color: colors.text }]}>
            Mes réservations
          </Text>
          <Text style={[styles.subtitle, { color: colors.textMuted }]}>
            Suivez tous les cours de votre enfant
          </Text>
        </View>

        <TouchableOpacity
          style={[
            styles.refreshButton,
            { backgroundColor: colors.primary + '15' },
          ]}
          onPress={charger}
        >
          <MaterialCommunityIcons
            name="refresh"
            size={21}
            color={colors.primary}
          />
        </TouchableOpacity>
      </View>

      <FlatList
        horizontal
        data={[
          { key: 'toutes', label: 'Toutes' },
          { key: 'en_attente', label: 'En attente' },
          { key: 'confirmee', label: 'Confirmées' },
          { key: 'terminee', label: 'Terminées' },
          { key: 'annulee', label: 'Annulées' },
        ]}
        keyExtractor={(item) => item.key}
        showsHorizontalScrollIndicator={false}
        contentContainerStyle={styles.filters}
        renderItem={({ item }) => {
          const active = filtre === item.key;

          return (
            <TouchableOpacity
              style={[
                styles.filter,
                {
                  backgroundColor: active
                    ? colors.primary
                    : colors.surface,
                  borderColor: active
                    ? colors.primary
                    : colors.border,
                },
              ]}
              onPress={() => setFiltre(item.key as any)}
            >
              <Text
                style={[
                  styles.filterText,
                  {
                    color: active ? 'white' : colors.textSecondary,
                  },
                ]}
              >
                {item.label}
              </Text>
            </TouchableOpacity>
          );
        }}
      />

      <FlatList
        data={liste}
        keyExtractor={(item) => item.id}
        renderItem={renderItem}
        contentContainerStyle={styles.list}
        showsVerticalScrollIndicator={false}
        ListEmptyComponent={
          <View style={styles.empty}>
            <MaterialCommunityIcons
              name="calendar-blank-outline"
              size={62}
              color={colors.textMuted}
            />

            <Text style={[styles.emptyTitle, { color: colors.text }]}>
              Aucune réservation
            </Text>

            <Text
              style={[
                styles.emptyText,
                { color: colors.textMuted },
              ]}
            >
              Vous n’avez pas encore de réservation dans cette catégorie.
            </Text>

            <TouchableOpacity
              style={[
                styles.emptyButton,
                { backgroundColor: colors.primary },
              ]}
              onPress={() =>
                navigation.navigate('TousRepetiteurs')
              }
            >
              <Text style={styles.emptyButtonText}>
                Trouver un répétiteur
              </Text>
            </TouchableOpacity>
          </View>
        }
      />
    </View>
  );
}

const styles = StyleSheet.create({
  container: { flex: 1 },
  center: {
    flex: 1,
    justifyContent: 'center',
    alignItems: 'center',
    padding: 24,
  },
  loadingText: {
    marginTop: 12,
    fontSize: 13,
  },
  header: {
    paddingHorizontal: 18,
    paddingTop: 18,
    paddingBottom: 14,
    borderBottomWidth: 1,
    flexDirection: 'row',
    alignItems: 'center',
    justifyContent: 'space-between',
  },
  title: {
    fontSize: 22,
    fontWeight: '800',
  },
  subtitle: {
    fontSize: 12,
    marginTop: 4,
  },
  refreshButton: {
    width: 42,
    height: 42,
    borderRadius: 21,
    alignItems: 'center',
    justifyContent: 'center',
  },
  filters: {
    paddingHorizontal: 16,
    paddingVertical: 12,
    gap: 8,
  },
  filter: {
    borderWidth: 1,
    paddingHorizontal: 14,
    paddingVertical: 8,
    borderRadius: 20,
  },
  filterText: {
    fontSize: 12,
    fontWeight: '700',
  },
  list: {
    paddingHorizontal: 16,
    paddingBottom: 30,
    gap: 12,
  },
  card: {
    borderRadius: 18,
    padding: 16,
    borderWidth: 1,
  },
  cardTop: {
    flexDirection: 'row',
    alignItems: 'flex-start',
    justifyContent: 'space-between',
    gap: 10,
  },
  tuteurBlock: {
    flex: 1,
    flexDirection: 'row',
    alignItems: 'center',
    gap: 10,
  },
  avatar: {
    width: 48,
    height: 48,
    borderRadius: 24,
    alignItems: 'center',
    justifyContent: 'center',
  },
  tuteurNom: {
    fontSize: 16,
    fontWeight: '800',
  },
  matiere: {
    fontSize: 12,
    marginTop: 3,
  },
  statusBadge: {
    flexDirection: 'row',
    alignItems: 'center',
    gap: 4,
    paddingHorizontal: 8,
    paddingVertical: 6,
    borderRadius: 12,
  },
  statusText: {
    fontSize: 10,
    fontWeight: '800',
  },
  infoGrid: {
    flexDirection: 'row',
    flexWrap: 'wrap',
    marginTop: 15,
    gap: 10,
  },
  infoItem: {
    width: '47%',
    flexDirection: 'row',
    alignItems: 'center',
    gap: 6,
  },
  infoText: {
    fontSize: 12,
    flexShrink: 1,
  },
  price: {
    fontSize: 12,
    fontWeight: '800',
  },
  child: {
    fontSize: 11,
    marginTop: 12,
  },
  message: {
    padding: 10,
    borderRadius: 10,
    marginTop: 10,
  },
  messageText: {
    fontSize: 11,
    fontStyle: 'italic',
    lineHeight: 17,
  },
  cardFooter: {
    marginTop: 14,
    paddingTop: 12,
    borderTopWidth: 1,
    borderTopColor: '#00000010',
    flexDirection: 'row',
    justifyContent: 'space-between',
    alignItems: 'center',
  },
  detailsLink: {
    fontSize: 12,
    fontWeight: '800',
  },
  empty: {
    alignItems: 'center',
    paddingHorizontal: 30,
    paddingTop: 70,
  },
  emptyTitle: {
    fontSize: 18,
    fontWeight: '800',
    marginTop: 15,
  },
  emptyText: {
    textAlign: 'center',
    fontSize: 13,
    lineHeight: 19,
    marginTop: 7,
  },
  emptyButton: {
    marginTop: 18,
    paddingHorizontal: 18,
    paddingVertical: 12,
    borderRadius: 13,
  },
  emptyButtonText: {
    color: 'white',
    fontSize: 13,
    fontWeight: '800',
  },
});
